<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <package android:name="net.kndy.shooterfull" />
        <package android:name="com.geoballistics.ballisticsarc" />
    </queries>

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DragCurve"
        tools:targetApi="31">

        <activity
            android:name=".ui.calc.CalculatorActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Skyward.Starting"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.calc.MyGearActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.MoreActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.ShotCounterActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.PartsActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.AnalysisActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.HitSimActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.TnfCompareScreen" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.HelpActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.GuideActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.SnapshotsActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.SolutionActivity" android:exported="false"
            android:parentActivityName=".ui.calc.CalculatorActivity" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.RiflesActivity" android:exported="false"
            android:parentActivityName=".ui.calc.CalculatorActivity" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.LoadsActivity" android:exported="false"
            android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.BulletLibraryActivity" android:exported="false"
            android:theme="@style/Theme.DragCurve.Calc" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.calc.RifleEditActivity" android:exported="false"
            android:theme="@style/Theme.DragCurve.Calc" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.calc.LoadEditActivity" android:exported="false"
            android:theme="@style/Theme.DragCurve.Calc" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.calc.BulletEditActivity" android:exported="false"
            android:theme="@style/Theme.DragCurve.Calc" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.calc.SettingsActivity" android:exported="false"
            android:parentActivityName=".ui.calc.CalculatorActivity" android:theme="@style/Theme.DragCurve.Calc"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.calc.ShareReceiveActivity" android:exported="true"
            android:label="@string/app_name" android:theme="@style/Theme.DragCurve.Calc">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.calc.ProfileBrowserActivity" android:exported="false"
            android:theme="@style/Theme.DragCurve.Calc" android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".ui.calc.LibrariesActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.BackupSyncActivity" android:exported="false" android:theme="@style/Theme.DragCurve.Calc" />
        <activity android:name=".ui.calc.ImportFromAppActivity" android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.calc.RiflesActivity" android:theme="@style/Theme.DragCurve.Calc" />

        <service
            android:name=".fill.ProfileImportService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fill_service_config" />
        </service>
    </application>
</manifest>
